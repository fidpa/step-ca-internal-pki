[Unit]
Description=Renew step-ca Service Certificate
After=network-online.target
Wants=network-online.target
# Optional: get notified when a renewal fails (renewals run unattended at night;
# without a hook, the first symptom is often a browser warning weeks later).
# See step-ca-renew-failure-notify.service.template
#OnFailure=step-ca-renew-failure-notify.service

[Service]
Type=oneshot

# CONFIGURE THESE ENVIRONMENT VARIABLES:
Environment="SERVICE_NAME=myservice"
Environment="SERVICE_RELOAD_CMD=systemctl reload nginx"

# Optional overrides:
# Environment="STEP_CA_HOME=/opt/step-ca"
# Environment="STEP_CA_CERT_DIR=/etc/ssl/step-ca"
# Environment="RENEWAL_THRESHOLD=30"

ExecStart=/usr/local/bin/renew-service-cert.sh

# Optional: persistent file log instead of the journal. Useful on hosts with
# short journald retention (busy systems can rotate a night run away within
# hours - a failed 03:30 renewal would leave no trace by morning):
#StandardOutput=append:/var/log/step-ca-renew.log
#StandardError=append:/var/log/step-ca-renew.log

# Security
User=root
PrivateTmp=true
ProtectSystem=strict
# /opt/step-ca/certs needed for intermediate_ca.srl (serial file)
ReadWritePaths=/etc/ssl/step-ca /var/log /opt/step-ca/certs

# NOTE: No Restart= here. systemd rejects Restart=on-failure for Type=oneshot
# units before v254 (e.g. Debian 12 ships v252) - the unit would fail to load.
# The daily timer provides the retry cadence instead.
